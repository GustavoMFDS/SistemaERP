# Ambiente
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info
ALLOW_NEGATIVE_STOCK=false

# JWT (use um secret forte; mínimo 32 chars)
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=sistemaemgo
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200

# Redis (obrigatório para refresh token/rotação)
REDIS_ADDR=localhost:6379
REDIS_DB=0

# Observabilidade
SERVICE_NAME=sistemaemgo-api
APP_VERSION=dev
OTEL_ENABLED=true
OTEL_EXPORTER=stdout
# Para OTLP (ex.: OpenTelemetry Collector):
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Postgres (opção A: use DATABASE_URL diretamente)
DATABASE_URL=postgres://sistemaemgo:sistemaemgo@localhost:5433/sistemaemgo?sslmode=disable

# Postgres (opção B: montar DATABASE_URL via partes)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=sistemaemgo
# POSTGRES_USER=sistemaemgo
# DB_PASSWORD=sistemaemgo
# PGSSLMODE=disable

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# NFC-e signing and schema validation (optional until homologation)
NFCE_CERTIFICATE_SECRET_DIR=
NFCE_SCHEMA_DIR=
NFCE_SCHEMA_ENTRYPOINT=
NFCE_SEFAZ_HOMOLOGATION_ENABLED=false
