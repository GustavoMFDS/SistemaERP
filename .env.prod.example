# Ambiente
APP_ENV=prod
HTTP_ADDR=:8080
LOG_LEVEL=info
ALLOW_NEGATIVE_STOCK=false

# JWT (preferencialmente via arquivo de segredo)
# JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=sistemaemgo
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200

# Redis (obrigatório para refresh token/rotação)
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_ADDR=HOST:6379
REDIS_DB=0

# Observabilidade
SERVICE_NAME=sistemaemgo-api
OTEL_ENABLED=true
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Postgres (preferencialmente via DATABASE_URL + secret file)
DATABASE_URL=postgres://USER:PASS@HOST:5432/DB?sslmode=require

# Alternativa: montar via partes + DB_PASSWORD_FILE
# POSTGRES_HOST=HOST
# POSTGRES_PORT=5432
# POSTGRES_DB=DB
# POSTGRES_USER=USER
# DB_PASSWORD_FILE=/run/secrets/db_password
# PGSSLMODE=require

# Frontend
VITE_API_BASE_URL=https://SEU_DOMINIO
