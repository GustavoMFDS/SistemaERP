# Production/staging example.
# Copy to a secret manager or deployment environment, not to a committed .env.
# Values marked REQUIRED must be replaced before startup.

# Required application environment
APP_ENV=production
APP_PUBLIC_URL=https://app.example.com
HTTP_ADDR=:8080
LOG_LEVEL=info
ALLOW_NEGATIVE_STOCK=false
DISABLE_REDIS=false

# Fiscal MVP must never be used in staging/production. Keep disabled until a SEFAZ-ready provider is configured.
FISCAL_PROVIDER=disabled

# Required PostgreSQL connection
DATABASE_URL=postgres://sistemaemgo_app:REPLACE_WITH_STRONG_DB_PASSWORD@postgres.example.internal:5432/sistemaemgo?sslmode=verify-full&sslrootcert=/run/secrets/postgres_ca.crt

# Required Redis connection for refresh-token rotation and rate limiting.
# Staging/production require REDIS_URL with rediss:// and certificate verification.
REDIS_URL=rediss://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis.example.internal:6379/0
# Split REDIS_ADDR/REDIS_PASSWORD settings are development/legacy-only and are rejected in staging/production.

# Required JWT settings
# Generate a strong secret with: go run ./backend/cmd/gensecret -format base64url -bytes 32
JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
# JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ISSUER=sistemaemgo
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=43200

# Required CORS settings
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Idempotency-Key

# Required metrics protection: set either bearer token or basic auth user/pass.
METRICS_BEARER_TOKEN=REPLACE_WITH_STRONG_METRICS_BEARER_TOKEN
# METRICS_BASIC_USER=metrics
# METRICS_BASIC_PASS=REPLACE_WITH_STRONG_METRICS_PASSWORD

# Required privacy/contact settings
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Required rate limits. Use 0 only in controlled tests, never in production.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_IDENTIFIER_PER_MINUTE=5
RATE_LIMIT_LOGIN_IP_IDENTIFIER_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_LOGOUT_PER_MINUTE=30
RATE_LIMIT_SALES_PER_MINUTE=60
RATE_LIMIT_FISCAL_PER_MINUTE=20

# Observability
SERVICE_NAME=sistemaemgo-api
APP_VERSION=2026.10.0
OTEL_ENABLED=true
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.internal:4318

# Optional database secret-file alternative. Use instead of DATABASE_URL when your runtime assembles it.
# POSTGRES_HOST=postgres.example.internal
# POSTGRES_PORT=5432
# POSTGRES_DB=sistemaemgo
# POSTGRES_USER=sistemaemgo_app
# DB_PASSWORD_FILE=/run/secrets/db_password
# PGSSLMODE=verify-full

# Optional frontend build-time variable, if building the frontend in this environment.
VITE_API_BASE_URL=https://api.example.com

# Must remain disabled outside local development.
ALLOW_DEMO_SEED=false

# NFC-e signing (mounted PEM secret directory; optional until homologation)
NFCE_CERTIFICATE_SECRET_DIR=
