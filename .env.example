# Copy to .env locally and never commit real secrets.
# Values below are development placeholders unless explicitly noted.
# Staging/production must replace secrets, CORS origins, database credentials,
# metrics credentials, and privacy contact values.

APP_ENV=dev
APP_PUBLIC_URL=http://localhost:5173
HTTP_ADDR=:8080
LOG_LEVEL=info
ALLOW_NEGATIVE_STOCK=false

# Generate a real value locally with: go run ./backend/cmd/gensecret -format base64url -bytes 32
JWT_SECRET=replace_with_random_32_plus_character_secret
JWT_ISSUER=sistemaemgo
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=43200

DATABASE_URL=postgres://sistemaemgo:local_dev_password@localhost:5433/sistemaemgo?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_DB=0
DISABLE_REDIS=false
# Optional production-style alternative:
# REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Idempotency-Key

# Per-minute limits. Set to 0 only in controlled local tests.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_IDENTIFIER_PER_MINUTE=5
RATE_LIMIT_LOGIN_IP_IDENTIFIER_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_LOGOUT_PER_MINUTE=30
RATE_LIMIT_SALES_PER_MINUTE=60
RATE_LIMIT_FISCAL_PER_MINUTE=20

# Required in staging/prod. In dev, /metrics is public unless these are set.
METRICS_BEARER_TOKEN=
METRICS_BASIC_USER=
METRICS_BASIC_PASS=

SERVICE_NAME=sistemaemgo-api
OTEL_ENABLED=true
OTEL_EXPORTER=stdout
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

PRIVACY_CONTACT_EMAIL=privacy@example.com
# Development seed requires explicit ALLOW_DEMO_SEED=1. Keep false in staging/prod.
ALLOW_DEMO_SEED=false

VITE_API_BASE_URL=http://localhost:8080
