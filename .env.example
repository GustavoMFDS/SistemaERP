# Copie para .env localmente (NÃO commitar) e ajuste os valores.
# Para produção, prefira injetar env vars via Docker/K8s/CI.

# Ambiente
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info
ALLOW_NEGATIVE_STOCK=false

# JWT (mínimo 32 chars). Dica: gere com `go run ./backend/cmd/gensecret -format base64url -bytes 32`
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=sistemaemgo
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200

# Redis (obrigatório para refresh token/rotação)
REDIS_ADDR=localhost:6379
REDIS_DB=0

# Observabilidade
SERVICE_NAME=sistemaemgo-api
OTEL_ENABLED=true
OTEL_EXPORTER=stdout
# Para OTLP (ex.: OpenTelemetry Collector):
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Postgres
DATABASE_URL=postgres://sistemaemgo:sistemaemgo@localhost:5433/sistemaemgo?sslmode=disable

# Alternativa (Docker/K8s secrets)
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# DB_PASSWORD_FILE=/run/secrets/db_password

# Alternativa (Docker/K8s secrets)
# REDIS_PASSWORD_FILE=/run/secrets/redis_password

# Frontend
VITE_API_BASE_URL=http://localhost:8080
